# ============================================================
# 墨灵闯关 · 环境变量示例
# ============================================================
# 使用方法：
#   cp backend/.env.example backend/.env
#   然后按下方注释填写自己的值；backend/.env 已被 gitignore，不要提交。
#
# 安全约定：
#   - 本文件可以提交、可以开源；不要写入任何真实 Key、Secret、密码、AppID。
#   - 生产环境请使用平台 Secret / 环境变量注入，不要放进镜像或前端。
# ============================================================

# ---------- 运行环境 ----------
# dev / test / production
# production 会强制关闭“体验登录”，并建议关闭 CORS 通配
ENV=dev

# ---------- LLM ----------
# auto: 有 DEEPSEEK_API_KEY 走真实模型，否则 Mock
# deepseek: 强制真实；mock: 强制离线
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2

# ---------- 联网检索 ----------
# 使用第三方 OpenAI 兼容网关时，通常没有 DeepSeek Search API，设 false
ENABLE_WEB_SEARCH=true
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
SEARCH_COUNT=6
SEARCH_QPS_GUARD=true

# ---------- MySQL 8+/9 ----------
# 本地开发推荐先运行 backend/scripts/start_mysql_dev.sh（独立 3307 实例）
# 生产请改为你的 MySQL 地址，并先创建 utf8mb4 数据库：
#   CREATE DATABASE lwa_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=lwa
# 仅本地开发实例的默认密码；生产必须替换
MYSQL_PASSWORD=lwa_dev_password
MYSQL_DATABASE=lwa_dev
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# ---------- 微信小程序登录 ----------
# 必填：微信公众平台 -> 开发管理 -> 开发设置 中的 AppID / AppSecret
# AppSecret 只放在后端 .env / 平台 Secret，绝不能写进小程序或 H5 前端。
# 未配置时 /api/v1/health 的 wechat_login=false，小程序会提示“微信登录暂不可用”；
# 开发/验收可用登录弹层的“体验登录（开发）”。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 登录态与配额 ----------
# 仅非生产环境可用；生产必须 false
DEV_LOGIN_ENABLED=true
AUTH_TOKEN_TTL_DAYS=30

# 是否强制配额（测试可 false；生产必须 true）
QUOTA_ENFORCED=true
# 游客累计试用组数（默认 1）
GUEST_TRIAL_LIMIT=1
# 登录普通用户每日组数
DAILY_QUOTA_USER=3
# VIP 预留（本期不开放购买/兑换）
VIP_ENABLED=false
VIP_DAILY_QUOTA=10
# 登录尝试限流（每 IP / 小时）
LOGIN_RATE_LIMIT_PER_HOUR=20

# ---------- 头像上传 ----------
AVATAR_UPLOAD_DIR=./data/uploads/avatars
# 2MB
AVATAR_MAX_BYTES=2097152

# ---------- 业务限制 ----------
MAX_TOPIC_CHARS=200
MIN_QUESTION_COUNT=3
MAX_QUESTION_COUNT=10
RATE_LIMIT_PER_HOUR=30
# 预留：匿名会话清理天数（当前无定时任务）
MAX_SESSION_AGE_DAYS=7

# ---------- 成本估算（元 / 百万 token） ----------
COST_INPUT_PER_M=2.0
COST_OUTPUT_PER_M=8.0

# ---------- CORS ----------
# 开发可用 *；生产改为你的 H5 域名，例如 https://app.example.com
CORS_ORIGINS=*
