# ============================================================
# 墨灵闯关 · 环境变量示例
# ============================================================
# 使用方法：
#   cp backend/.env.example backend/.env
#   然后按下方注释填写自己的值；backend/.env 已被 gitignore，不要提交。
#
# 安全约定：
#   - 本文件可以提交、可以开源；不要写入任何真实 Key、Secret、密码、AppID。
#   - 生产环境请使用平台 Secret / 环境变量注入，不要放进镜像或前端。
# ============================================================

# ---------- 运行环境 ----------
# dev / test / production
# production 会强制关闭“体验登录”，并建议关闭 CORS 通配
ENV=dev

# ---------- LLM ----------
# auto: 有 DEEPSEEK_API_KEY 走真实模型，否则 Mock
# deepseek: 强制真实；mock: 强制离线
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 1017 面向阿里云 MaaS 等兼容网关；使用官方 DeepSeek 时改为 deepseek-flash
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2
# 单次出题上限约 5 题；15 题会自动分批生成后合并
QUESTION_GENERATE_BATCH_SIZE=5

# ---------- 联网检索 ----------
# 总开关；false 时完全退回“纯模型知识出题”（不请求任何搜索服务）
ENABLE_WEB_SEARCH=true
# auto: 有 TAVILY_API_KEY 时用 Tavily，否则尝试官方 DeepSeek Search
# tavily / deepseek: 强制指定；none: 关闭
SEARCH_PROVIDER=auto
SEARCH_COUNT=6
SEARCH_QPS_GUARD=true

# ---------- Tavily 联网检索 ----------
# 获取免费 Key：https://app.tavily.com ；只放后端 .env / 平台 Secret，绝不能进小程序
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# 无 Key 时允许 Tavily keyless（免费、限流）；生产建议 false 并配置正式 Key
TAVILY_ALLOW_KEYLESS=true
# basic（1 credit，默认）/ advanced（2 credits，覆盖更广）
TAVILY_SEARCH_DEPTH=basic
# general / news / finance
TAVILY_TOPIC=general
TAVILY_TIMEOUT=25

# 仅在 SEARCH_PROVIDER=deepseek 或 auto 回退官方 Search 时使用
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com

# ---------- 知识库 RAG ----------
# 总开关；false 时资料库入口仍可见但不可新建/出题
KB_ENABLED=true
# 游客 1 个；登录用户 5 个；每库 30 份资料；单文件 20MB；单篇正文 20 万字
KB_MAX_PER_GUEST=1
KB_MAX_PER_USER=5
KB_MAX_DOCS_PER_KB=30
KB_MAX_FILE_BYTES=20971520
KB_MAX_TEXT_CHARS=200000
KB_MAX_PAGES=300
KB_MAX_URL_BYTES=5242880
KB_UPLOAD_DIR=./data/uploads/kb
KB_UPLOAD_PER_HOUR=60
KB_CREATE_PER_HOUR=20
KB_MAX_SESSION_KBS=3
# 分块 500～700 字；检索 top_k / 候选数 / 证据字符预算
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=80
KB_RETRIEVE_TOP_K=8
KB_RETRIEVE_CANDIDATES=16
KB_EVIDENCE_MAX_CHARS=6000
# Agentic RAG 最多检索几轮（含改写重检）
RAG_MAX_ROUNDS=2

# ---------- Embedding（OpenAI 兼容） ----------
# auto: 真实模式且有 Key 用网关；否则 mock（哈希向量，离线演示）
# openai: 强制真实；mock: 强制哈希；none: 关闭知识库向量化
EMBEDDING_PROVIDER=auto
# 留空时回退 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=30

# ---------- Qdrant 向量库 ----------
# 留空 QDRANT_URL 时使用嵌入式 local mode（零运维，单进程）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=kb_chunks_v1
QDRANT_TIMEOUT=30

# ---------- MySQL 8+/9 ----------
# 本地开发推荐先运行 backend/scripts/start_mysql_dev.sh（独立 3307 实例）
# 生产请改为你的 MySQL 地址，并先创建 utf8mb4 数据库：
#   CREATE DATABASE lwa_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=lwa
# 仅本地开发实例的默认密码；生产必须替换
MYSQL_PASSWORD=lwa_dev_password
MYSQL_DATABASE=lwa_dev
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# ---------- 微信小程序登录 ----------
# 必填：微信公众平台 -> 开发管理 -> 开发设置 中的 AppID / AppSecret
# AppSecret 只放在后端 .env / 平台 Secret，绝不能写进小程序或 H5 前端。
# 未配置时 /api/v1/health 的 wechat_login=false，小程序会提示“微信登录暂不可用”；
# 开发/验收可用登录弹层的“体验登录（开发）”。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 注销冷却与身份哈希（留空时用 WECHAT_APP_SECRET 作为盐）
ACCOUNT_DELETE_COOLDOWN_HOURS=24
IDENTITY_PEPPER=

# ---------- 登录态与配额 ----------
# 仅非生产环境可用；生产必须 false
DEV_LOGIN_ENABLED=true
AUTH_TOKEN_TTL_DAYS=30

# 是否强制配额（测试可 false；生产必须 true）
QUOTA_ENFORCED=true
# 游客累计试用组数（默认 1）
GUEST_TRIAL_LIMIT=1
# 登录普通用户每日组数
DAILY_QUOTA_USER=3
# VIP 预留（本期不开放购买/兑换）
VIP_ENABLED=false
VIP_DAILY_QUOTA=10
# 登录尝试限流（每 IP / 小时）
LOGIN_RATE_LIMIT_PER_HOUR=20

# ---------- 头像上传 ----------
AVATAR_UPLOAD_DIR=./data/uploads/avatars
# 2MB
AVATAR_MAX_BYTES=2097152

# ---------- 业务限制 ----------
MAX_TOPIC_CHARS=200
MIN_QUESTION_COUNT=3
MAX_QUESTION_COUNT=15
RATE_LIMIT_PER_HOUR=30
# 预留：匿名会话清理天数（当前无定时任务）
MAX_SESSION_AGE_DAYS=7

# ---------- 成本估算（元 / 百万 token） ----------
COST_INPUT_PER_M=2.0
COST_OUTPUT_PER_M=8.0

# ---------- CORS ----------
# 开发可用 *；生产改为你的 H5 域名，例如 https://app.example.com
CORS_ORIGINS=*
