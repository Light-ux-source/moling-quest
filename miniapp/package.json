{
  "name": "learning-with-ai-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "AI 出题学习助手 - Taro 小程序端",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "seed": "../backend/.venv/bin/python scripts/seed_demo.py --reset",
    "e2e": "node scripts/e2e.js",
    "screenshot": "node scripts/screenshot.js"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@tarojs/cli": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/react": "^18.3.3",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  }
}
